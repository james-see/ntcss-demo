<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Warehouse Inventory Manager</display-name>

    <!-- Elytron Security Constraint - require authentication for API -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Warehouse API</web-resource-name>
            <url-pattern>/rest/api/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>admin</role-name>
            <role-name>operator</role-name>
            <role-name>viewer</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Health endpoint is open -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Health Check</web-resource-name>
            <url-pattern>/rest/api/health</url-pattern>
        </web-resource-collection>
        <!-- No auth-constraint means open access -->
    </security-constraint>

    <!-- Use Elytron BASIC authentication -->
    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>ApplicationRealm</realm-name>
    </login-config>

    <security-role>
        <role-name>admin</role-name>
    </security-role>
    <security-role>
        <role-name>operator</role-name>
    </security-role>
    <security-role>
        <role-name>viewer</role-name>
    </security-role>
</web-app>